POSTGRES_DB=barbearia
POSTGRES_USER=barbearia
POSTGRES_PASSWORD=senha_local
POSTGRES_PORT=5432

# Generate a long random secret before deployment. The default compose value is for local development only.
JWT_ACCESS_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3333

# Required for the first administrator account. Use a valid, unused CPF and a strong password.
SEED_ADMIN_NAME=Administrador da Barbearia
SEED_ADMIN_EMAIL=admin@exemplo.com
SEED_ADMIN_CPF=529.982.247-25
SEED_ADMIN_PASSWORD=senha_padrao_123
